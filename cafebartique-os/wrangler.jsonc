/**
 * Cafe Bartique OS
 * Cloudflare Worker Configuration
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cafebartique-os",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-07",

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true,

  "compatibility_flags": [
    "nodejs_compat"
  ],

  /**
   * Daily Toast Analytics Sync
   *
   * Cloudflare Cron uses UTC.
   * 09:30 UTC = 5:30 AM Eastern during daylight-saving time.
   */
  "triggers": {
    "crons": [
      "30 9 * * *"
    ]
  },

  /**
   * Cloudflare KV Storage
   */
  "kv_namespaces": [
    {
      "binding": "TOAST_TOKEN_CACHE",
      "id": "cff17eacd085460eb6d7c3739a5b98ca"
    },
    {
      "binding": "ANALYTICS_CACHE",
      "id": "72ac5d38537c4086a8f34c5656f02216"
    }
  ]
}